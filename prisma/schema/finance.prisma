// Finance domain: investments, profit withdrawals, loans, transfers,
// expenses, other incomes.

model Investment {
  id               String   @id @default(uuid())
  owner_id         String
  date             DateTime @default(now()) @db.Date
  shareholder_id   String?
  shareholder_name String
  invest_amount    Decimal  @default(0) @db.Decimal(15, 2)
  withdraw_amount  Decimal  @default(0) @db.Decimal(15, 2)
  account_id       String?
  account_name     String
  notes            String   @default("")
  created_by       String?
  created_at       DateTime @default(now())

  shareholder Shareholder? @relation(fields: [shareholder_id], references: [id], onDelete: Restrict)
  account     Account?     @relation(fields: [account_id], references: [id], onDelete: Restrict)

  @@index([owner_id])
  @@index([date])
  @@index([owner_id, date(sort: Desc)])
  @@map("investments")
}

model ProfitWithdrawal {
  id               String   @id @default(uuid())
  owner_id         String
  date             DateTime @default(now()) @db.Date
  shareholder_id   String?
  shareholder_name String
  amount           Decimal  @default(0) @db.Decimal(15, 2)
  account_id       String?
  account_name     String
  profit_month     Int?
  profit_year      Int?
  // Optional "to" side of a month range (profit_month/profit_year are the "from").
  to_month         Int?
  to_year          Int?
  notes            String   @default("")
  created_by       String?
  created_at       DateTime @default(now())

  shareholder Shareholder? @relation(fields: [shareholder_id], references: [id], onDelete: Restrict)
  account     Account?     @relation(fields: [account_id], references: [id], onDelete: Restrict)

  @@index([owner_id])
  @@index([date])
  @@index([owner_id, date(sort: Desc)])
  @@map("profit_withdrawals")
}

model LoanLender {
  id              String     @id @default(uuid())
  owner_id        String
  name            String
  lender_type     LenderType @default(person)
  phone           String     @default("")
  address         String     @default("")
  opening_balance Decimal    @default(0) @db.Decimal(15, 2)
  /// The day the opening balance is as of - what a passbook prints on its
  /// first line. Nullable because every existing account predates the field;
  /// the statement still treats the opening balance as coming before every
  /// transaction, which is what "opening" means.
  opening_date    DateTime?  @db.Date
  notes           String     @default("")
  is_active       Boolean    @default(true)
  deleted_at      DateTime?
  deleted_by      String?
  created_by      String?
  created_at      DateTime   @default(now())

  loans Loan[]

  @@index([owner_id])
  @@map("loan_lenders")
}

model Loan {
  id                    String              @id @default(uuid())
  owner_id              String
  date                  DateTime            @default(now()) @db.Date
  lender_id             String?
  lender_name           String
  loan_type             LoanType            @default(personal)
  transaction_type      LoanTransactionType @default(receive)
  received_amount       Decimal             @default(0) @db.Decimal(15, 2)
  payment_amount        Decimal             @default(0) @db.Decimal(15, 2)
  /// Dead. Superseded by payment_category below, which says what the money in
  /// the two columns above WAS rather than putting interest in a third column
  /// nothing adds up. Left in place because dropping a column is its own
  /// decision and nothing reads this one.
  interest_amount       Decimal             @default(0) @db.Decimal(15, 2)
  /// "principal" | "profit" - what this movement was.
  ///
  /// The money itself stays in received_amount / payment_amount either way,
  /// which is what keeps the cash and bank balances right: a profit payment is
  /// still cash leaving the drawer, and Balance.tsx folds those two columns
  /// into every account. Only the PRINCIPAL owed is calculated differently -
  /// a profit row moves it by nothing at all.
  ///
  /// Plain text rather than a Postgres enum, like recycle_bin_items.type:
  /// extending an enum needs a hand-written ALTER TYPE with no precedent here.
  payment_category      String              @default("principal")
  /// Which Expenses category a profit PAYMENT is filed under, kept on the loan
  /// rather than only on the expense it writes.
  ///
  /// That is what makes a loan row self-sufficient: deleting one hard-deletes
  /// it into a recycle-bin snapshot and takes its expense with it, so restoring
  /// has to rebuild that expense from the loan alone. The denormalised name
  /// beside it is the house rule for every *_id, and here it also survives the
  /// category itself being deleted.
  expense_category_id   String?
  expense_category_name String              @default("")
  /// The expense this row wrote so the P&L can see the interest paid, and the
  /// other-income it wrote for interest earned. Exactly one is ever set, and
  /// only on a profit row.
  ///
  /// Server-owned: loan.validation.ts does not name them and z.object strips
  /// what it does not name, so no client can point a loan at somebody else's
  /// expense. reconcileLoanProfitMirror is their only writer.
  ///
  /// The twin carries no account_id - this row already moved the cash, and
  /// Balance.tsx sums both tables per account_id. See the migration for what
  /// happens if that is forgotten.
  expense_id            String?
  other_income_id       String?
  account_id            String?
  account_name          String
  notes                 String              @default("")
  deleted_at            DateTime?
  deleted_by            String?
  created_by            String?
  created_at            DateTime            @default(now())

  lender           LoanLender?      @relation(fields: [lender_id], references: [id], onDelete: SetNull)
  account          Account?         @relation(fields: [account_id], references: [id], onDelete: Restrict)
  expense_category ExpenseCategory? @relation(fields: [expense_category_id], references: [id], onDelete: SetNull)
  expense          Expense?         @relation(fields: [expense_id], references: [id], onDelete: SetNull)
  other_income     OtherIncome?     @relation(fields: [other_income_id], references: [id], onDelete: SetNull)

  @@index([owner_id])
  @@index([date])
  @@index([owner_id, date(sort: Desc)])
  @@map("loans")
}

model AccountTransfer {
  id                String   @id @default(uuid())
  owner_id          String
  date              DateTime @default(now()) @db.Date
  from_account_id   String?
  from_account_name String
  to_account_id     String?
  to_account_name   String
  amount            Decimal  @default(0) @db.Decimal(15, 2)
  notes             String   @default("")
  created_by        String?
  created_at        DateTime @default(now())

  from_account Account? @relation("TransferFrom", fields: [from_account_id], references: [id], onDelete: Restrict)
  to_account   Account? @relation("TransferTo", fields: [to_account_id], references: [id], onDelete: Restrict)

  @@index([owner_id])
  @@index([date])
  @@index([owner_id, date(sort: Desc)])
  @@map("account_transfers")
}

model Expense {
  id            String    @id @default(uuid())
  owner_id      String
  date          DateTime  @default(now()) @db.Date
  category_id   String?
  category_name String
  amount        Decimal   @default(0) @db.Decimal(15, 2)
  account_id    String?
  account_name  String
  branch_id     String?
  branch_name   String    @default("")
  notes         String    @default("")
  deleted_at    DateTime?
  deleted_by    String?
  created_by    String?
  created_at    DateTime  @default(now())

  category            ExpenseCategory?    @relation(fields: [category_id], references: [id], onDelete: Restrict)
  account             Account?            @relation(fields: [account_id], references: [id], onDelete: Restrict)
  salary_transactions SalaryTransaction[]
  /// Profit payments that wrote this expense. At most one, but Prisma names a
  /// back-relation in the plural whatever the cardinality.
  loans               Loan[]

  @@index([owner_id])
  @@index([date])
  @@index([category_id])
  @@index([owner_id, date(sort: Desc)])
  @@map("expenses")
}

model OtherIncome {
  id            String     @id @default(uuid())
  owner_id      String
  date          DateTime   @default(now()) @db.Date
  income_type   IncomeType @default(supplier)
  supplier_id   String?
  supplier_name String     @default("")
  source_name   String     @default("")
  amount        Decimal    @default(0) @db.Decimal(15, 2)
  account_id    String?
  account_name  String     @default("")
  notes         String     @default("")
  created_by    String?
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  supplier Supplier? @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  account  Account?  @relation(fields: [account_id], references: [id], onDelete: Restrict)
  /// Profit receipts that wrote this row. See Expense.loans.
  loans    Loan[]

  @@index([owner_id])
  @@index([date])
  @@index([owner_id, date(sort: Desc)])
  @@map("other_incomes")
}
